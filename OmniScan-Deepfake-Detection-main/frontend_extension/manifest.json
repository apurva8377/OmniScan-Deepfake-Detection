{
  "manifest_version": 3,
  "name": "Deepfake Shield",
  "version": "1.0",
  "description": "Scans on-screen videos for spatial-temporal deepfake artifacts.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Video"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}